# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...           # generator (default openai:gpt-5.5)
GEMINI_API_KEY=...              # vision critic (default google:gemini-3.5-flash); GOOGLE_API_KEY also works
# ANTHROPIC_API_KEY=sk-ant-... # only if you point an agent at an anthropic: model (see below)

# Provider + model for each agent, as a Pydantic AI "provider:model" string.
# Applies to BOTH the CLI and the web backend (the web form seeds from these).
# CLI --model / --critic-model flags override them. Examples:
# CAD_GEN_MODEL=openai:gpt-5.5                  # generator
# CAD_GEN_CRITIC_MODEL=google:gemini-3.5-flash  # vision critic
# CAD_GEN_VIEW_MODEL=google:gemini-3.5-flash    # drawing view-locator for the reproject check
#                                               # (vision; defaults to the critic default)
# Switch providers by changing the prefix (set the matching API key above):
# CAD_GEN_MODEL=anthropic:claude-opus-4-8
# CAD_GEN_CRITIC_MODEL=anthropic:claude-opus-4-8
# Note: the CLI's API-key preflight only checks openai/google/anthropic keys;
# other providers skip the check and fail at call time if their key is missing.

# Web backend (uvicorn cad_gen.web.server:app) — all optional
# CAD_GEN_WEB_ORIGINS=http://localhost:3000   # comma-separated CORS allow-list
# CAD_GEN_RUNS_DIR=runs                        # artifacts root
