# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...           # generator (default openai:gpt-5.5)
GEMINI_API_KEY=...              # vision critic (default google:gemini-3.5-flash); GOOGLE_API_KEY also works

# Optional overrides (also available as CLI flags)
# CAD_GEN_MODEL=openai:gpt-5.5
# CAD_GEN_CRITIC_MODEL=google:gemini-3.5-flash

# Web backend (uvicorn cad_gen.web.server:app) — all optional
# CAD_GEN_WEB_ORIGINS=http://localhost:3000   # comma-separated CORS allow-list
# CAD_GEN_RUNS_DIR=runs                        # artifacts root
