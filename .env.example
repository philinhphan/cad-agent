# ─────────────────────────────────────────────────────────────────────────────
# cad-gen configuration — copy to .env and fill in. .env is gitignored.
#   cp .env.example .env
# Only GEMINI_API_KEY is required for the default setup. Everything else is optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── API keys ────────────────────────────────────────────────────────────────
# Covers the generator, vision critic, and drawing view-locator by default.
# GOOGLE_API_KEY also works. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Only needed if you point an agent at that provider (see CAD_GEN_MODEL below).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# ── Models (PydanticAI "provider:model" strings) ─────────────────────────────
# Applies to BOTH the CLI and the web backend (the web form seeds from these).
# CLI --model / --critic-model flags override them.
# CAD_GEN_MODEL=google:gemini-3.5-flash         # generator
# CAD_GEN_CRITIC_MODEL=google:gemini-3.5-flash  # vision critic
# CAD_GEN_VIEW_MODEL=google:gemini-3.5-flash    # drawing view-locator (vision; defaults to critic)
#
# Switch providers by changing the prefix (and set the matching API key above):
# CAD_GEN_MODEL=anthropic:claude-opus-4-8
# CAD_GEN_CRITIC_MODEL=anthropic:claude-opus-4-8
# Note: the CLI's API-key preflight only checks google/anthropic keys; other
# providers skip the check and fail at call time if their key is missing.

# ── BMW LLM API (BMW PCs only) ───────────────────────────────────────────────
# On a BMW PC only the BMW LLM gateway is reachable (public OpenAI/Google/Anthropic
# endpoints are blocked). Two ways to use it:
#  (a) One switch — force EVERY agent onto BMW (defaults to openai/gpt-5-mini):
# CAD_GEN_BMW=1
#  (b) Or target it per-agent with the bmw: provider prefix (model ids per the BMW
#      catalog, e.g. openai/gpt-5-mini, openai/gpt-4o, anthropic/claude-sonnet-4-5):
# CAD_GEN_MODEL=bmw:openai/gpt-5-mini
# CAD_GEN_CRITIC_MODEL=bmw:openai/gpt-5-mini   # critic needs a vision-capable model
# CAD_GEN_VIEW_MODEL=bmw:openai/gpt-5-mini
#
# Credentials (required whenever BMW is used — from your BMW LLM API onboarding):
# LLM_API_PROD_KEY=...        # the x-apikey header value
# CLIENT_ID=...               # WebEAM machine2machine client id
# CLIENT_SECRET=...           # WebEAM machine2machine client secret
# (Alternative to CLIENT_ID/SECRET: supply a pre-fetched token directly.)
# LLM_ACCESS_TOKEN=...
# LLM_ACCESS_TOKEN_EXP=2025-08-29T18:33:07.336067
#
# Optional overrides:
# BMW_LLM_BASE_URL=https://api.gcp.cloud.bmw/llmapi   # EU PROD (default). EU QA:
#   https://api.int.gcp.cloud.bmw/llmapi  · US: append /us to either.
# BMW_CA_CERT_PATH=BMW_Trusted_Certificates_Latest.pem  # auto-downloaded if absent

# ── Reasoning / thinking effort ──────────────────────────────────────────────
# minimal | low | medium | high | xhigh — provider-agnostic, opt-in.
# Unset = leave the provider's own default untouched.
# CAD_GEN_REASONING_EFFORT=high           # generator
# CAD_GEN_CRITIC_REASONING_EFFORT=medium  # let the critic think before judging (closes false-accepts)

# ── Web backend (uvicorn cad_gen.web.server:app) — all optional ──────────────
# CAD_GEN_WEB_ORIGINS=http://localhost:3000   # comma-separated CORS allow-list
# CAD_GEN_RUNS_DIR=runs                        # artifacts root

# ── Optional fal.ai "showcase" image button in the web run view ──────────────
# Requires the web extra (`uv sync --extra web`); only runs when the button is clicked.
# FAL_KEY=...
# CAD_GEN_SHOWCASE_MODEL=fal-ai/flux-pro/kontext

# ── Frontend ─────────────────────────────────────────────────────────────────
# The Next.js app reads its own env from web/.env (see web/.env.example):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
